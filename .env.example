# Quorum — server configuration
# Copy to `.env` (git-ignored) and fill in at least ONE provider key.
# All values are read on the server only; none are sent to the browser.

# --- AI providers -----------------------------------------------------------
# Each provider is enabled when its API key is set. Model and base URL are optional.

# OpenAI (or any OpenAI-compatible endpoint that supports JSON-schema structured outputs)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Council behaviour ------------------------------------------------------

# Provider for seats with no explicit choice, single-provider boards, the verdict
# synthesis step and per-seat fallback. Defaults to the first configured of
# openai, anthropic, google.
# QUORUM_DEFAULT_PROVIDER=openai

# Per-request timeout for AI calls, in milliseconds (1000–600000).
# QUORUM_TIMEOUT_MS=120000

# --- Access control ---------------------------------------------------------

# Require HTTP Basic Auth for the whole app ("username:password").
# Strongly recommended for any deployment reachable from the internet:
# without it, anyone with the URL can spend your AI credits.
# QUORUM_BASIC_AUTH=board:change-me

# --- Server (production build) ----------------------------------------------
# PORT=3000
# HOST=0.0.0.0
